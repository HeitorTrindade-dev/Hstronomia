# Ambiente
ENVIRONMENT=development
DEBUG=True
APP_TIMEZONE=UTC

# Configurações do Servidor
HOST=0.0.0.0
PORT=8000

# CORS (origens permitidas separadas em formato JSON)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Banco de Dados PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hstronomia
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hstronomia

# Autenticação e Segurança (JWT e Bcrypt)
SECRET_KEY=sua-chave-secreta-de-pelo-menos-32-caracteres-para-desenvolvimento
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OPERATIONAL_TOKEN_EXPIRE_MINUTES=120
BCRYPT_ROUNDS=12

# Rate Limiting (Autenticação Operacional por PIN e Login do Dono)
OPERATIONAL_RATE_LIMIT_MAX_ATTEMPTS=5
OPERATIONAL_RATE_LIMIT_WINDOW_SECONDS=300
OPERATIONAL_RATE_LIMIT_MAX_KEYS=10000
